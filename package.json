{
  "name": "soyli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "imports": {
    "#app-data/*": "./packages/app-data/src/*.ts",
    "#assets": "./packages/assets/src/index.ts",
    "#assets/*": "./packages/assets/src/*.ts",
    "#backend/*": "./packages/backend/src/*.ts",
    "#blossom/*": "./packages/blossom/src/*.ts",
    "#client/*": "./packages/client/src/*.ts",
    "#collaboration/*": "./packages/collaboration/src/*.ts",
    "#diagnostics": "./packages/diagnostics/src/index.ts",
    "#dynamic-backends/fixtures/*": "./packages/dynamic-backends/fixtures/*",
    "#dynamic-backends/*": "./packages/dynamic-backends/src/*.ts",
    "#examples/*": "./packages/examples/*.ts",
    "#grasp/*": "./packages/grasp/src/*.ts",
    "#identity/*": "./packages/identity/src/*.ts",
    "#input/*": "./packages/input/src/*.ts",
    "#lifecycle": "./packages/lifecycle/src/index.ts",
    "#lifecycle/*": "./packages/lifecycle/src/*.ts",
    "#migration": "./packages/migration/src/index.ts",
    "#multiplayer/*": "./packages/multiplayer/src/*.ts",
    "#nostr/discovery-relays.json": "./packages/nostr/discovery-relays.json",
    "#nostr/*": "./packages/nostr/src/*.ts",
    "#protocol": "./packages/protocol/src/index.ts",
    "#protocol/*": "./packages/protocol/src/*.ts",
    "#publish": "./packages/publish/src/index.ts",
    "#publish/*": "./packages/publish/src/*.ts",
    "#remix": "./packages/remix/src/index.ts",
    "#remix/*": "./packages/remix/src/*.ts",
    "#runtime": "./packages/runtime/src/index.ts",
    "#runtime/appearance-control": "./packages/runtime/src/appearance-control.tsx",
    "#runtime/media-controls": "./packages/runtime/src/media-controls.tsx",
    "#runtime/multiplayer-settings": "./packages/runtime/src/multiplayer-settings.tsx",
    "#runtime/settings-panel": "./packages/runtime/src/settings-panel.tsx",
    "#runtime/*": "./packages/runtime/src/*.ts"
  },
  "bin": {
    "soyli": "src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "soyli": "bun src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "test:standalone": "bun run build && bun scripts/smoke.ts"
  },
  "dependencies": {
    "@contextvm/sdk": "0.13.16",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.31.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napplet/shim": "0.31.0",
    "@noble/hashes": "2.0.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@scure/base": "2.4.0",
    "applesauce-core": "7.0.3",
    "applesauce-loaders": "7.0.2",
    "applesauce-relay": "7.0.0",
    "applesauce-signers": "7.0.1",
    "entities": "7.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.45.0",
    "nostr-tools": "2.25.2",
    "nostr-wasm": "0.1.0",
    "playwright-core": "1.63.0",
    "playwright-core-mac-compat": "npm:playwright-core@1.61.1",
    "qrcode": "1.5.4",
    "quickjs-emscripten": "0.31.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rxjs": "7.8.2",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
